nextflow_process {

    name "Test Process FILTERPDB"
    script "../main.nf"
    process "FILTERPDB"

    tag "modules"
    tag "modules_local"
    tag "filterpdb"

    test("predicted_set1 - default thresholds") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003', 'A0A009DWJ5', 'A0A009DYA3')
                    .collectFile(name: 'predicted_set1_ids_mapping.0.txt', newLine: true, sort: true)
                    .map { ids -> [
                        [ id:'predicted_set1', structure_type:'predicted', chunk_id:0 ],
                        ids,
                        file(params.pipelines_testdata_base_path + 'prepare_input/predicted_set1.zip', checkIfExists: true)
                    ] }
                input[1] = 25
                input[2] = 1500
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.ids[0][1]).readLines() == ['A0A003', 'A0A009DWJ5', 'A0A009DYA3'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    // A0A009DWJ5 (47 residues) and A0A009DYA3 (50) are rejected because they are not longer than the minimum
    test("predicted_set1 - minimum 50 residues") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003', 'A0A009DWJ5', 'A0A009DYA3')
                    .collectFile(name: 'predicted_set1_ids_mapping.0.txt', newLine: true, sort: true)
                    .map { ids -> [
                        [ id:'predicted_set1', structure_type:'predicted', chunk_id:0 ],
                        ids,
                        file(params.pipelines_testdata_base_path + 'prepare_input/predicted_set1.zip', checkIfExists: true)
                    ] }
                input[1] = 50
                input[2] = 1500
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.ids[0][1]).readLines() == ['A0A003'] },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("predicted_set1 - default thresholds - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003', 'A0A009DWJ5', 'A0A009DYA3')
                    .collectFile(name: 'predicted_set1_ids_mapping.0.txt', newLine: true, sort: true)
                    .map { ids -> [
                        [ id:'predicted_set1', structure_type:'predicted', chunk_id:0 ],
                        ids,
                        file(params.pipelines_testdata_base_path + 'prepare_input/predicted_set1.zip', checkIfExists: true)
                    ] }
                input[1] = 25
                input[2] = 1500
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
