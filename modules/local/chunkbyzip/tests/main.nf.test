nextflow_process {

    name "Test Process CHUNKBYZIP"
    script "../main.nf"
    process "CHUNKBYZIP"

    tag "modules"
    tag "modules_local"
    tag "chunkbyzip"

    test("predicted_set1 - three structures - chunk size 2") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003\tpredicted_set1.zip', 'A0A009DWJ5\tpredicted_set1.zip', 'A0A009DYA3\tpredicted_set1.zip')
                    .collectFile(name: 'predicted_set1.all_ids_mapping.tsv', newLine: true, sort: true)
                    .map { tsv -> [ [ id:'predicted_set1', structure_type:'predicted' ], tsv ] }
                input[1] = 2
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.chunk_folder[0][1].size() == 2 },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("predicted_set1 - three structures - chunk size 2 - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003\tpredicted_set1.zip', 'A0A009DWJ5\tpredicted_set1.zip', 'A0A009DYA3\tpredicted_set1.zip')
                    .collectFile(name: 'predicted_set1.all_ids_mapping.tsv', newLine: true, sort: true)
                    .map { tsv -> [ [ id:'predicted_set1', structure_type:'predicted' ], tsv ] }
                input[1] = 2
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
