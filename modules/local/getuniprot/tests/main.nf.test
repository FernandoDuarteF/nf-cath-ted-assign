nextflow_process {

    name "Test Process GETUNIPROT"
    script "../main.nf"
    process "GETUNIPROT"

    tag "modules"
    tag "modules_local"
    tag "getuniprot"

    // Queries the live UniProt REST API, so only stable parts of the output are snapshotted
    test("predicted_set1 - two accessions") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003', 'A0A009DWJ5')
                    .collectFile(name: 'predicted_set1_ids_mapping.0.txt', newLine: true, sort: true)
                    .map { ids -> [ [ id:'predicted_set1', structure_type:'predicted', chunk_id:0 ], ids ] }
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert rows.size() > 1 },
                { assert snapshot(
                    rows[0],
                    process.out.findAll { key, _val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("predicted_set1 - two accessions - stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = channel.of('A0A003', 'A0A009DWJ5')
                    .collectFile(name: 'predicted_set1_ids_mapping.0.txt', newLine: true, sort: true)
                    .map { ids -> [ [ id:'predicted_set1', structure_type:'predicted', chunk_id:0 ], ids ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
